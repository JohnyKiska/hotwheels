{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnyKiska/hotwheels/blob/integration/catalog-foundation/docs/project-management/project-state.schema.json",
  "title": "HW Catalog Project State",
  "description": "Canonical, version-controlled state for the HW Catalog Project Manager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "project",
    "workstreams",
    "components",
    "tasks",
    "decisions",
    "blockers",
    "changelog"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "updated_at",
        "source_of_truth",
        "working_branch"
      ],
      "properties": {
        "project_id": {
          "const": "hw-catalog"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_of_truth": {
          "const": "github"
        },
        "working_branch": {
          "type": "string",
          "minLength": 1
        },
        "last_verified_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "on_hold",
            "maintenance",
            "completed"
          ]
        }
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/workStatus"
          },
          "sort_order": {
            "type": "integer"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "workstream_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "directory",
              "file",
              "service",
              "database",
              "external_system",
              "domain_area",
              "other"
            ]
          },
          "status": {
            "$ref": "#/$defs/workStatus"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "source_refs": {
            "$ref": "#/$defs/stringList"
          },
          "sort_order": {
            "type": "integer"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "workstream_id",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "backlog",
              "planned",
              "in_progress",
              "blocked",
              "review",
              "done",
              "cancelled"
            ]
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "workstream_id": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dependencies": {
            "$ref": "#/$defs/stringList"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "$ref": "#/$defs/stringList"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "decision",
          "date",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "superseded"
            ]
          },
          "source_refs": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "accepted_risk"
            ]
          },
          "related_task_ids": {
            "$ref": "#/$defs/stringList"
          },
          "source_refs": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "summary"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workStatus": {
      "enum": [
        "not_assessed",
        "planned",
        "in_progress",
        "blocked",
        "review",
        "done",
        "needs_audit"
      ]
    }
  }
}
