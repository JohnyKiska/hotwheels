# Storage
HW_CATALOG_DATA_DIR=

# GitHub OAuth
HW_GITHUB_CLIENT_ID=
HW_GITHUB_CLIENT_SECRET=
HW_GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/account/oauth/github/callback

# Application
HW_FRONTEND_URL=http://127.0.0.1:8000
HW_ALLOWED_ORIGINS=http://127.0.0.1:8000
