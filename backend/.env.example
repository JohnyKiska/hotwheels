# Encryption keys
HW_OAUTH_ENCRYPTION_KEY=
HW_EMAIL_ENCRYPTION_KEY=

# Email SMTP
HW_SMTP_HOST=smtp.gmail.com
HW_SMTP_PORT=587
HW_SMTP_SECURITY=starttls
HW_SMTP_FROM_EMAIL=
HW_SMTP_USERNAME=
HW_SMTP_PASSWORD=
