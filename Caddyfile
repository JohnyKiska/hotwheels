{$HW_PUBLIC_HOST} {
    encode zstd gzip

    @backend path /api/* /health /docs* /openapi.json /redoc*
    handle @backend {
        reverse_proxy api:8000
    }

    handle {
        root * /srv
        hide /backend /docs /research /.github /.git /.env /.env.* /README* /Dockerfile /compose.yaml /Caddyfile /*.md /*.yml /*.yaml
        try_files {path} {path}/ /index.html
        file_server
    }
}
