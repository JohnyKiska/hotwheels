# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# DNS A/AAAA records for this host must point to the deployment server.
HW_PUBLIC_HOST=staging.example.com
HW_PUBLIC_BASE_URL=https://staging.example.com
HW_FRONTEND_URL=https://staging.example.com
HW_ALLOWED_ORIGINS=https://staging.example.com

# PostgreSQL. Use a long random password with URL-safe characters only.
POSTGRES_DB=hw_catalog
POSTGRES_USER=hw_catalog
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Generate each Fernet key independently:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HW_EMAIL_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
HW_OAUTH_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_FERNET_KEY
# Generate at least 32 random characters for privacy-preserving rate-limit HMAC.
HW_AUTH_RATE_LIMIT_KEY=CHANGE_ME_RANDOM_HMAC_SECRET

# OAuth is optional until provider applications are configured.
HW_GITHUB_CLIENT_ID=
HW_GITHUB_CLIENT_SECRET=
HW_GITHUB_REDIRECT_URI=https://staging.example.com/api/v1/account/oauth/github/callback
HW_GOOGLE_CLIENT_ID=
HW_GOOGLE_CLIENT_SECRET=
HW_GOOGLE_REDIRECT_URI=https://staging.example.com/api/v1/account/oauth/google/callback

# SMTP is optional until the email-worker profile is enabled.
HW_SMTP_HOST=
HW_SMTP_PORT=587
HW_SMTP_SECURITY=starttls
HW_SMTP_FROM_EMAIL=
HW_SMTP_FROM_NAME=HW Catalog
HW_SMTP_USERNAME=
HW_SMTP_PASSWORD=
HW_SMTP_TIMEOUT=20
HW_EMAIL_WORKER_POLL_SECONDS=5
HW_EMAIL_WORKER_BATCH_SIZE=20
