        "purchase_price": {
          "type": [
            "number",
            "null"
          ],
          "required": false
        },
        "purchase_currency": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "purchase_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "required": false
        },
        "estimated_value": {
          "type": [
            "number",
            "null"
          ],
          "required": false,
          "description": "Не считать фактом покупки; оценки лучше хранить отдельными снимками."
        },
        "notes": {
          "type": "string",
          "required": true,
          "default": ""
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "required": false
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "required": false
        }
      }
    },
    "ChangeLog": {
      "description": "Неизменяемая запись о ручной правке, импорте или откате.",
