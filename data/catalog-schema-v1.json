        "wheel_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string",
          "default": ""
        }
      }
    },
    "FieldSource": {
      "description": "Подтверждение происхождения конкретного поля каталога.",
      "fields": {
        "field": {
          "type": "string",
          "required": true
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "null"
          ],
          "required": true
        },
        "source_type": {
          "type": "string",
          "enumRef": "sourceType",
          "required": true
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "verification_status": {
          "type": "string",
          "enumRef": "verificationStatus",
          "required": true
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "min": 0,
          "max": 1,
          "required": false
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "required": false
        },
        "note": {
          "type": "string",
          "default": ""
        }
      }
    },
    "CollectionItems": {
      "description": "Экземпляр в личной коллекции пользователя; не копирует весь каталог.",
      "primaryKey": "id",
      "fields": {
        "id": {
          "type": "string",
          "required": true
        },
        "user_id": {
          "type": "string",
          "required": true
        },
        "catalog_id": {
          "type": [
            "string",
            "null"
          ],
          "required": false,
          "description": "Связь с Catalog.id; может отсутствовать до сопоставления."
        },
        "sku_snapshot": {
