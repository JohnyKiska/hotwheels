{
  "schemaVersion": "1.0.0",
  "status": "draft",
  "description": "Логическая схема каталога Hot Wheels и личной коллекции. Это контракт данных для импорта и будущего интерфейса, не миграция существующей коллекции и не физическая БД.",
  "principles": [
    "Общий каталог и личная коллекция хранятся отдельно.",
    "Неизвестные значения оставлять null или пустыми; не угадывать.",
    "Каждое подтверждаемое поле может хранить источник, статус проверки и уверенность.",
    "sku — основной внешний ключ сопоставления; внутренний id стабилен и не зависит от SKU.",
    "Повторяющиеся SKU не объединять автоматически: отправлять на проверку.",
    "История импорта и ручных правок должна сохраняться отдельно от текущих значений.",
    "Не менять collection.json без отдельного проверенного плана миграции."
  ],
  "enums": {
    "verificationStatus": [
      "unverified",
      "verified",
      "probable",
      "not_found",
      "conflict"
    ],
    "recordStatus": [
      "active",
      "needs_review",
      "duplicate_candidate",
      "archived"
    ],
    "sourceType": [
      "hot_wheels_wiki",
      "all_hot_wheels",
      "wheel_wonderland",
      "manufacturer",
      "user",
      "other"
    ],
    "packageType": [
      "single",
      "multi_pack",
      "team_transport",
      "gift_set",
      "unknown"
    ],
    "condition": [
      "mint",
      "near_mint",
      "played",
      "damaged",
      "unknown"
    ]
  },
  "entities": {
    "Catalog": {
      "description": "Одна запись на модель/вариант выпуска в общем справочнике.",
      "primaryKey": "id",
      "fields": {
        "id": {
          "type": "string",
          "required": true,
          "description": "Стабильный внутренний ID; не генерировать из отображаемого названия."
        },
        "sku": {
          "type": [
            "string",
            "null"
          ],
          "required": false,
          "description": "Артикул/код Hot Wheels, нормализованный для поиска."
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "required": false,
          "description": "ID базовой модели, связывающий варианты одной машины."
        },
        "variant": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "brand": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "required": false
        },
        "segment": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "series": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "series_number": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "package_type": {
          "type": "string",
          "enumRef": "packageType",
          "required": true
        },
        "vehicle_1": {
          "type": [
            "object",
            "null"
          ],
          "required": false,
          "description": "Основное транспортное средство; состав см. Vehicle."
        },
        "vehicle_2": {
          "type": [
            "object",
            "null"
          ],
          "required": false,
          "description": "Второе транспортное средство для наборов вроде Team Transport."
        },
        "scale": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "body_color": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "interior_color": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "base_color": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "window_color": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "wheel_type": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "wheel_color": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "notes": {
          "type": "string",
          "required": true,
          "default": ""
        },
        "verification_status": {
          "type": "string",
          "enumRef": "verificationStatus",
          "required": true,
          "default": "unverified"
        },
        "record_status": {
          "type": "string",
          "enumRef": "recordStatus",
          "required": true,
          "default": "active"
        },
        "sources": {
          "type": "array",
          "items": "FieldSource",
          "required": true,
          "default": []
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "required": false
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "required": false
        }
      }
    },
    "Vehicle": {
      "description": "Описание одного транспортного средства внутри записи каталога.",
      "fields": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "body_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "interior_color": {
          "type": [
            "string",
