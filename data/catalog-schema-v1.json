        "id": {
          "type": "string",
          "required": true
        },
        "entity_type": {
          "type": "string",
          "required": true
        },
        "entity_id": {
          "type": "string",
          "required": true
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "before": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "null"
          ],
          "required": false
        },
        "after": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "null"
          ],
          "required": false
        },
        "action": {
          "type": "string",
          "required": true
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "batch_id": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "changed_at": {
          "type": "string",
          "format": "date-time",
          "required": true
        },
        "changed_by": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "note": {
          "type": "string",
          "default": ""
        }
      }
    },
    "ImportBatch": {
      "description": "Отчёт об одном запуске импорта/обогащения.",
      "fields": {
        "id": {
          "type": "string",
          "required": true
        },
        "source_type": {
          "type": "string",
          "enumRef": "sourceType",
          "required": true
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ],
          "required": false
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "required": true
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "required": false
        },
        "total_rows": {
          "type": "integer",
          "required": true,
          "default": 0
        },
        "matched_rows": {
          "type": "integer",
          "required": true,
          "default": 0
        },
        "created_rows": {
          "type": "integer",
          "required": true,
          "default": 0
        },
        "updated_rows": {
          "type": "integer",
          "required": true,
          "default": 0
        },
        "review_rows": {
          "type": "integer",
          "required": true,
          "default": 0
        },
        "error_rows": {
          "type": "integer",
          "required": true,
          "default": 0
        },
