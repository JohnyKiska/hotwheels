          "type": "string",
          "enum": [
            "running",
            "completed",
            "completed_with_warnings",
            "failed"
          ],
          "required": true
        }
      }
    }
  },
  "relationships": [
    {
      "from": "Catalog.model_id",
      "to": "Catalog.model_id",
      "type": "many-to-one logical grouping",
      "note": "Связывает варианты одной базовой модели; не является внешним ключом к отдельной таблице."
    },
    {
      "from": "CollectionItems.catalog_id",
      "to": "Catalog.id",
      "type": "many-to-one"
    },
    {
      "from": "Catalog.sources",
      "to": "FieldSource",
      "type": "one-to-many"
    },
    {
      "from": "ChangeLog.entity_id",
      "to": "Catalog.id or CollectionItems.id",
      "type": "polymorphic reference"
    },
    {
      "from": "ChangeLog.batch_id",
      "to": "ImportBatch.id",
      "type": "optional"
    }
  ],
  "workflow": {
    "enrichmentStatuses": [
      "exact",
      "probable",
      "not_found",
      "conflict"
    ],
    "duplicatePolicy": "По SKU искать кандидатов, но неоднозначные совпадения не сливать автоматически.",
    "importStages": [
      "load",
      "normalize",
      "match",
      "validate",
      "preview",
      "apply_to_working_copy",
      "report",
      "rollback_if_needed"
    ],
    "firstPilot": "30–50 разнородных записей; сравнить источники и качество сопоставления до массового обогащения."
  },
  "nextSteps": [
    "Проверить модель на пилотной выборке из 30–50 записей.",
    "Утвердить поля и правила SKU/вариантов до массового наполнения.",
    "Создать отдельный рабочий каталог и импортировать в него данные без изменения collection.json.",
    "После проверки выбрать постоянное хранилище и подключить интерфейс массового редактирования."
  ]
